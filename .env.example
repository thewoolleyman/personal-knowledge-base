# Google OAuth credentials
# Get these from: https://console.cloud.google.com/apis/credentials
PKB_GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
PKB_GOOGLE_CLIENT_SECRET="GOCSPX-your-client-secret"

# Obsidian vault folder ID in Google Drive
# Enables the 'obsidian' source, which searches only within this folder.
# Get the folder ID from the Google Drive URL of your Obsidian vault mirror folder.
PKB_OBSIDIAN_FOLDER_ID="your-google-drive-folder-id"

# Notion integration token
# Create an integration at https://www.notion.so/my-integrations
# Then share your pages/databases with the integration.
PKB_NOTION_TOKEN="ntn_your-notion-integration-token"

# Optional: custom token storage path (default: ~/.config/pkb/token.json)
# PKB_TOKEN_PATH="/custom/path/token.json"

# Optional: custom server address (default: :8080)
# PKB_SERVER_ADDR=":3000"

# Optional: bind to Tailscale interface for secure remote access (default: false)
# See README.md "Remote Access via Tailscale" for setup instructions.
# PKB_TAILSCALE=true
